          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लोगों को साथ लाएँ"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozd össze a kapcsolataidat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riunisci le tue persone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大切な人をひとつに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소중한 사람들을 함께 모으세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng je mensen samen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbierz swoich bliskich"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta as tuas pessoas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adună-ți persoanele apropiate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собери своих людей вместе"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samla dina kontakter"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے لوگوں کو اکٹھا کریں"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你在乎的人聚在一起"
          }
        }
      }
    },
    "tutorial.groups.2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a profile, find Groups, and choose Add to Group. Select a group to add the person. A person can belong to more than one group."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ملفًا شخصيًا، وابحث عن المجموعات، واختر إضافة إلى مجموعة. حدد مجموعة لإضافة الشخص إليها. يمكن للشخص الانتماء إلى أكثر من مجموعة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevři profil, najdi Skupiny a vyber Přidat do skupiny. Vyber skupinu pro danou osobu. Člověk může patřit do více skupin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ein Profil, suche Gruppen und wähle Zur Gruppe hinzufügen. Wähle eine Gruppe für die Person. Eine Person kann mehreren Gruppen angehören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε προφίλ, βρες τις Ομάδες και επίλεξε Προσθήκη σε ομάδα. Επίλεξε ομάδα για το άτομο. Ένα άτομο μπορεί να ανήκει σε πολλές ομάδες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un perfil, busca Grupos y elige Agregar al grupo. Selecciona un grupo para añadir a la persona. Una persona puede pertenecer a varios grupos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un profil, repère Groupes et choisis Ajouter au groupe. Sélectionne un groupe pour y ajouter la personne. Une personne peut appartenir à plusieurs groupes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח פרופיל, למצוא את קבוצות ולבחור הוספה לקבוצה. בוחרים קבוצה כדי להוסיף אליה את האדם. אדם יכול להשתייך לכמה קבוצות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल खोलें, समूह ढूँढें और समूह में जोड़ें चुनें। व्यक्ति को जोड़ने के लिए समूह चुनें। एक व्यक्ति कई समूहों में हो सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyiss meg egy profilt, keresd meg a Csoportok részt, és válaszd a Hozzáadás csoporthoz lehetőséget. Válassz csoportot a személynek. Egy személy több csoport tagja is lehet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un profilo, trova Gruppi e scegli Aggiungi al gruppo. Seleziona un gruppo per aggiungere la persona. Una persona può appartenere a più gruppi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールを開き、「グループ」で「グループに追加」を選びます。追加先のグループを選択してください。複数のグループに参加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필을 열고 그룹에서 그룹에 추가를 선택하세요. 그룹을 선택해 사람을 추가하세요. 한 사람은 여러 그룹에 속할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een profiel, zoek Groepen en kies Aan groep toevoegen. Kies een groep om de persoon toe te voegen. Iemand kan bij meerdere groepen horen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz profil, znajdź Grupy i wybierz Dodaj do grupy. Wybierz grupę, aby dodać osobę. Jedna osoba może należeć do kilku grup."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um perfil, encontra Grupos e escolhe Adicionar ao grupo. Seleciona um grupo para adicionar a pessoa. Uma pessoa pode pertencer a vários grupos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide un profil, găsește Grupuri și alege Adaugă în grup. Selectează un grup pentru persoană. O persoană poate aparține mai multor grupuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой профиль, найди Группы и выбери Добавить в группу. Выбери группу для человека. Один человек может состоять в нескольких группах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna en profil, hitta Grupper och välj Lägg till i grupp. Välj en grupp för personen. En person kan tillhöra flera grupper."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پروفائل کھولیں، گروپس تلاش کریں اور گروپ میں شامل کریں منتخب کریں۔ فرد کو شامل کرنے کے لیے گروپ چنیں۔ ایک فرد کئی گروپوں میں ہو سکتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开个人资料，找到“群组”并选择“添加到群组”。选择一个群组来添加此联系人。一个联系人可以加入多个群组。"
          }
        }
      }
    },
    "tutorial.groups.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your circles, your way"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوائرك بطريقتك"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje okruhy po tvém"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kreise, ganz nach dir"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κύκλοι σου, όπως τους θέλεις"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus círculos, a tu manera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes cercles, à ta façon"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המעגלים שלך, בדרך שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दायरे, आपका तरीका"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A te köreid, a te szabályaid"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue cerchie, a modo tuo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分らしいつながり方を"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

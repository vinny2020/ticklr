    "tutorial.phone.2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose individual people with the contact picker, or import all contacts Ticklr can access."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أشخاصًا عبر منتقي جهات الاتصال، أو استورد كل جهات الاتصال التي يستطيع Ticklr الوصول إليها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber jednotlivé lidi pomocí výběru kontaktů nebo importuj všechny kontakty dostupné pro Ticklr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einzelne Personen in der Kontaktauswahl oder importiere alle Kontakte, auf die Ticklr zugreifen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε άτομα με τον επιλογέα επαφών ή εισήγαγε όλες τις επαφές στις οποίες έχει πρόσβαση το Ticklr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige personas con el selector de contactos o importa todos los contactos a los que Ticklr puede acceder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis des personnes dans le sélecteur de contacts ou importe tous les contacts accessibles à Ticklr."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לבחור אנשים באמצעות בורר אנשי הקשר, או לייבא את כל אנשי הקשר של־Ticklr יש גישה אליהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपर्क चयनकर्ता से लोगों को चुनें या वे सभी संपर्क आयात करें जिन तक Ticklr की पहुँच है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz ki embereket a névjegyválasztóval, vagy importáld az összes névjegyet, amelyhez a Ticklr hozzáfér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le persone nel selettore dei contatti oppure importa tutti i contatti accessibili a Ticklr."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先ピッカーで相手を選ぶか、Ticklrがアクセスできるすべての連絡先を読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연락처 선택기에서 사람을 선택하거나 Ticklr가 접근할 수 있는 모든 연락처를 가져오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies personen met de contactkiezer of importeer alle contacten waartoe Ticklr toegang heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz osoby za pomocą selektora kontaktów lub zaimportuj wszystkie kontakty dostępne dla Ticklr."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe pessoas no seletor de contactos ou importa todos os contactos a que o Ticklr tem acesso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege persoane din selectorul de contacte sau importă toate contactele la care Ticklr are acces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери отдельных людей через выбор контактов или импортируй все контакты, к которым у Ticklr есть доступ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj personer med kontaktväljaren eller importera alla kontakter som Ticklr har åtkomst till."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رابطوں کے انتخاب کے ذریعے افراد چنیں، یا وہ تمام رابطے درآمد کریں جن تک Ticklr کی رسائی ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用联系人选择器选择特定联系人，或导入 Ticklr 有权访问的所有联系人。"
          }
        }
      }
    },

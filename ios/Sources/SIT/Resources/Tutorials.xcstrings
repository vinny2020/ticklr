    "tutorial.linkedin.3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your connections CSV. After import, find your connections in Network and add any missing contact details."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملف CSV لعلاقاتك. بعد الاستيراد، اعثر عليها في الشبكة وأضف تفاصيل الاتصال الناقصة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber CSV soubor se spojeními. Po importu je najdeš v Síti a můžeš doplnit chybějící kontaktní údaje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deine Kontakt-CSV. Nach dem Import findest du deine Kontakte unter Netzwerk und kannst fehlende Kontaktdaten ergänzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε το CSV των συνδέσεών σου. Μετά την εισαγωγή, βρες τις στο Δίκτυο και συμπλήρωσε τα στοιχεία επικοινωνίας που λείπουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el CSV de tus conexiones. Tras importarlo, busca tus conexiones en Red y añade los datos de contacto que falten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis le CSV de tes relations. Après l’importation, retrouve-les dans Réseau et ajoute les coordonnées manquantes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור את קובץ ה־CSV של הקשרים. לאחר הייבוא, אפשר למצוא אותם ברשת ולהשלים פרטי קשר חסרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने संपर्कों की CSV चुनें। आयात के बाद उन्हें नेटवर्क में खोजें और संपर्क की छूटी हुई जानकारी जोड़ें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki a kapcsolataid CSV-fájlját. Importálás után keresd meg őket a Hálózatban, és pótold a hiányzó elérhetőségeket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il CSV dei collegamenti. Dopo l’importazione, trovali in Rete e aggiungi i recapiti mancanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つながりのCSVを選択します。読み込み後は「ネットワーク」で相手を見つけ、不足する連絡先情報を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인맥 CSV를 선택하세요. 가져온 뒤 네트워크에서 인맥을 찾고 빠진 연락처 정보를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies het CSV-bestand van je connecties. Vind ze na de import in Netwerk en vul ontbrekende contactgegevens aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plik CSV kontaktów. Po imporcie znajdź kontakty w Sieci i uzupełnij brakujące dane kontaktowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o CSV das tuas ligações. Depois de importar, encontra-as em Rede e adiciona os dados de contacto em falta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege fișierul CSV al conexiunilor. După import, găsește-le în Rețea și adaugă datele de contact care lipsesc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери CSV-файл контактов. После импорта найди их в разделе Сеть и добавь недостающие контактные данные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj din kontakt-CSV. Efter importen hittar du kontakterna i Nätverk och kan lägga till kontaktuppgifter som saknas."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے رابطوں کی CSV منتخب کریں۔ درآمد کے بعد انہیں نیٹ ورک میں تلاش کریں اور رابطے کی نامکمل تفصیلات شامل کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择联系人 CSV 文件。导入后，在“人脉”中找到联系人，并补充缺失的联系方式。"
          }
        }
      }
    },
    "tutorial.tickle.1.title": {

    "tutorial.groups.1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep family, friends, and work connections together in groups."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع العائلة والأصدقاء وعلاقات العمل في مجموعات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdružuj rodinu, přátele a pracovní kontakty do skupin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisiere Familie, Freunde und berufliche Kontakte in Gruppen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτησε μαζί οικογένεια, φίλους και επαγγελματικές επαφές σε ομάδες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne a familiares, amigos y contactos de trabajo en grupos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rassemble ta famille, tes amis et tes relations professionnelles dans des groupes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לארגן משפחה, חברים וקשרים מקצועיים בקבוצות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवार, दोस्तों और काम के संपर्कों को समूहों में साथ रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendezd csoportokba a családtagokat, barátokat és munkakapcsolatokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riunisci familiari, amici e contatti di lavoro in gruppi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族、友人、仕事の連絡先をグループにまとめましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족, 친구, 직장 인맥을 그룹으로 모아 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng familie, vrienden en werkcontacten samen in groepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącz rodzinę, przyjaciół i kontakty zawodowe w grupy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne familiares, amigos e contactos de trabalho em grupos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reunește familia, prietenii și contactele profesionale în grupuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяй семью, друзей и рабочие контакты в группы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samla familj, vänner och arbetskontakter i grupper."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھر والوں، دوستوں اور کام کے رابطوں کو گروپوں میں اکٹھا رکھیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将家人、朋友和工作联系人整理到群组中。"
          }
        }
      }
    },
    "tutorial.groups.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your people together"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع الأشخاص الذين يهمونك"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dej své lidi dohromady"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring deine Kontakte zusammen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φέρε τους ανθρώπους σου κοντά"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa a tu gente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

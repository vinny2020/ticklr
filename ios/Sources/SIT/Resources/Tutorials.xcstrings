            "value": "Πρόσθεσε σημείωση και αποθήκευσε. Βρες την υπενθύμιση στο προφίλ και στην καρτέλα Tickle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una nota y guarda. Encontrarás tu recordatorio en el perfil y en la pestaña Tickle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une note, puis enregistre. Retrouve ton rappel dans le profil et l’onglet Tickle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להוסיף הערה ולשמור. התזכורת מופיעה בפרופיל ובלשונית תזכורות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट जोड़ें और सहेजें। रिमाइंडर प्रोफ़ाइल और Tickle टैब में मिलेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá jegyzetet, majd mentsd el. Az emlékeztetőt a profilon és a Tickle lapon találod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una nota e salva. Trova il promemoria sul profilo e nella scheda Tickle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモを追加して保存します。リマインダーはプロフィールと「Tickle」タブで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모를 추가하고 저장하세요. 프로필과 Tickle 탭에서 알림을 확인할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een notitie toe en sla op. Je herinnering staat op het profiel en in het tabblad Tickle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj notatkę i zapisz. Przypomnienie znajdziesz na profilu i na karcie Tickle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma nota e guarda. Encontra o lembrete no perfil e no separador Tickle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă o notă și salvează. Găsești mementoul pe profil și în fila Tickle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь заметку и сохрани. Напоминание появится в профиле и на вкладке Tickle."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en anteckning och spara. Du hittar påminnelsen i profilen och på fliken Tickle."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹ شامل کر کے محفوظ کریں۔ یاددہانی پروفائل اور یاددہانیاں ٹیب میں ملے گی۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加备注并保存。在个人资料和 Tickle 标签页中查看提醒。"
          }
        }
      }
    },
    "tutorial.groups.1.title": {

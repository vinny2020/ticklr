    "tutorial.groups.3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the plus button in Groups to create your own circle, then choose its members."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم زر الإضافة في المجموعات لإنشاء دائرتك واختيار أعضائها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítkem plus ve Skupinách vytvoř vlastní okruh a vyber jeho členy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle mit der Plus-Schaltfläche unter Gruppen deinen eigenen Kreis und wähle seine Mitglieder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε το κουμπί συν στις Ομάδες για να δημιουργήσεις τον δικό σου κύκλο και να επιλέξεις τα μέλη του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón más de Grupos para crear tu propio círculo y elegir sus miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le bouton plus dans Groupes pour créer ton cercle et choisir ses membres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשתמש בלחצן הפלוס בקבוצות כדי ליצור מעגל משלך ולבחור את חבריו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह में प्लस बटन से अपना दायरा बनाएँ और उसके सदस्य चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Csoportok plusz gombjával hozd létre saját körödet, majd válaszd ki a tagjait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il pulsante più in Gruppi per creare la tua cerchia e scegliere i membri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「グループ」のプラスボタンで自分のグループを作り、メンバーを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹의 더하기 버튼으로 나만의 모임을 만들고 구성원을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak met de plusknop in Groepen je eigen kring en kies de leden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj przycisku plus w Grupach, aby utworzyć własny krąg i wybrać jego członków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o botão mais em Grupos para criar o teu círculo e escolher os membros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește butonul plus din Grupuri pentru a crea propriul cerc și a alege membrii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми плюс в разделе Группы, чтобы создать свой круг и выбрать участников."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd plusknappen i Grupper för att skapa din egen krets och välja medlemmar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گروپ میں جمع کا بٹن استعمال کر کے اپنا حلقہ بنائیں اور اس کے ارکان منتخب کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“群组”中的加号按钮创建自己的圈子，再选择成员。"
          }
        }
      }
    },

    "tutorial.linkedin.2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request your connections data from LinkedIn and save the downloaded CSV on your phone. The import screen has the export instructions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب بيانات علاقاتك من LinkedIn، واحفظ ملف CSV الذي تم تنزيله على هاتفك. تتضمن شاشة الاستيراد إرشادات التصدير."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádej LinkedIn o data svých spojení a ulož stažený CSV soubor do telefonu. Pokyny k exportu najdeš na obrazovce importu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordere deine Kontaktdaten bei LinkedIn an und speichere die heruntergeladene CSV auf deinem Telefon. Die Importansicht enthält die Exportanleitung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζήτησε τα δεδομένα συνδέσεών σου από το LinkedIn και αποθήκευσε το CSV που κατέβασες στο τηλέφωνο. Η οθόνη εισαγωγής περιέχει τις οδηγίες εξαγωγής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita tus datos de conexiones a LinkedIn y guarda el CSV descargado en tu teléfono. La pantalla de importación incluye las instrucciones para exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande tes données de relations à LinkedIn et enregistre le CSV téléchargé sur ton téléphone. L’écran d’importation contient les instructions d’export."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבקש מ־LinkedIn את נתוני הקשרים ולשמור את קובץ ה־CSV שהורד בטלפון. במסך הייבוא מופיעות הוראות הייצוא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedIn से अपने संपर्कों का डेटा माँगें और डाउनलोड की गई CSV फ़ोन में सहेजें। आयात स्क्रीन पर निर्यात के निर्देश दिए गए हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérd le a kapcsolataid adatait a LinkedIntől, és mentsd a letöltött CSV-fájlt a telefonodra. Az importálási képernyőn megtalálod az exportálási útmutatót."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi i dati dei collegamenti a LinkedIn e salva il CSV scaricato sul telefono. La schermata di importazione contiene le istruzioni per l’esportazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedInでつながりのデータをリクエストし、ダウンロードしたCSVを電話に保存します。読み込み画面にエクスポートの手順があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedIn에 인맥 데이터를 요청하고 내려받은 CSV를 휴대전화에 저장하세요. 가져오기 화면에 내보내기 안내가 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag je connectiegegevens op bij LinkedIn en sla het gedownloade CSV-bestand op je telefoon op. Het importscherm bevat de exportinstructies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś LinkedIn o dane swoich kontaktów i zapisz pobrany plik CSV w telefonie. Instrukcje eksportu znajdziesz na ekranie importowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede os dados das tuas ligações ao LinkedIn e guarda o CSV transferido no telefone. O ecrã de importação tem as instruções de exportação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicită datele conexiunilor de la LinkedIn și salvează fișierul CSV descărcat pe telefon. Ecranul de import conține instrucțiunile de export."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запроси данные своих контактов в LinkedIn и сохрани скачанный CSV-файл на телефоне. Инструкции по экспорту есть на экране импорта."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begär dina kontaktuppgifter från LinkedIn och spara den hämtade CSV-filen på telefonen. Importskärmen har instruktioner för exporten."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedIn سے اپنے رابطوں کا ڈیٹا طلب کریں اور ڈاؤن لوڈ شدہ CSV فون میں محفوظ کریں۔ درآمد کی اسکرین پر برآمد کرنے کی ہدایات موجود ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 LinkedIn 申请联系人数据，并将下载的 CSV 文件保存到手机。导入页面提供了导出说明。"
          }
        }
      }
    },

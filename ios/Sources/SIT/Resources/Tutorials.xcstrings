    "tutorial.tickle.1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a profile and tap Create a tickle to set a reminder to reconnect."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ملفًا شخصيًا واضغط على «أنشئ تذكيرًا» لضبط تذكير بالتواصل مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevři profil a klepnutím na Vytvořit tickle nastav připomínku, abyste se znovu spojili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ein Profil und tippe auf Tickle erstellen, um eine Erinnerung zum Kontaktaufnehmen einzurichten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε ένα προφίλ και πάτησε Δημιούργησε tickle για να ορίσεις υπενθύμιση να επικοινωνήσεις ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un perfil y toca Crear un tickle para programar un recordatorio y retomar el contacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un profil et appuie sur Créer un tickle pour programmer un rappel et reprendre contact."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לפתוח פרופיל וללחוץ על “צור tickle” כדי להגדיר תזכורת ליצירת קשר מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल खोलें और फिर संपर्क करने का रिमाइंडर सेट करने के लिए “टिकल बनाएँ” पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyiss meg egy profilt, és koppints a Tickle létrehozása lehetőségre, hogy emlékeztetőt állíts be a kapcsolatfelvételhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un profilo e tocca Crea un tickle per impostare un promemoria e riprendere i contatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールを開き、「リマインドを作る」をタップして、また連絡するためのリマインダーを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필을 열고 Tickle 만들기를 눌러 다시 연락할 알림을 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een profiel en tik op Tickle maken om een herinnering in te stellen en weer contact op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz profil i dotknij Utwórz tickle, aby ustawić przypomnienie o ponownym kontakcie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um perfil e toca em Criar um tickle para definir um lembrete para retomar o contacto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide un profil și atinge Creează un tickle pentru a seta un memento de a relua legătura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой профиль и нажми Создать tickle, чтобы настроить напоминание снова связаться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna en profil och tryck på Skapa ett tickle för att ställa in en påminnelse om att höras."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پروفائل کھولیں اور دوبارہ رابطے کی یاددہانی مقرر کرنے کے لیے “ٹِکل بنائیں” پر ٹیپ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开个人资料并点按“创建 tickle”，设置重新联系的提醒。"
          }
        }
      }
    },
    "tutorial.tickle.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a rhythm or a special date"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وتيرة أو تاريخًا مميزًا"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber rytmus nebo zvláštní datum"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Rhythmus oder ein besonderes Datum"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε ρυθμό ή ιδιαίτερη ημερομηνία"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una frecuencia o una fecha especial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un rythme ou une date spéciale"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירת תדירות או תאריך מיוחד"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तय अंतराल या कोई खास तारीख चुनें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz ritmust vagy különleges dátumot"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un ritmo o una data speciale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペースや特別な日を選ぼう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주기나 특별한 날짜를 고르세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een ritme of een bijzondere datum"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz rytm lub wyjątkową datę"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um ritmo ou uma data especial"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un ritm sau o dată specială"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери ритм или особую дату"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en rytm eller ett särskilt datum"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تکرار یا کوئی خاص تاریخ منتخب کریں"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择频率或特别的日期"
          }
        }
      }
    },
    "tutorial.tickle.2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a frequency and starting date. For a birthday, choose Birthday and set the date; the tickle repeats annually."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر التكرار وتاريخ البدء. لعيد ميلاد، اختر عيد ميلاد وحدد التاريخ؛ يتكرر tickle سنويًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber četnost a počáteční datum. Pro narozeniny vyber Narozeniny a nastav datum; tickle se bude opakovat každý rok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Häufigkeit und Startdatum. Für einen Geburtstag wähle Geburtstag und lege das Datum fest; der Tickle wiederholt sich jährlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε συχνότητα και ημερομηνία έναρξης. Για γενέθλια, επίλεξε Γενέθλια και όρισε την ημερομηνία· το tickle επαναλαμβάνεται ετησίως."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una frecuencia y una fecha de inicio. Para un cumpleaños, elige Cumpleaños y establece la fecha; el tickle se repite cada año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une fréquence et une date de début. Pour un anniversaire, choisis Anniversaire et indique la date ; le tickle se répète chaque année."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור תדירות ותאריך התחלה. ליום הולדת, יש לבחור יום הולדת ולהגדיר את התאריך; ה־tickle חוזר מדי שנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवृत्ति और आरंभ की तारीख चुनें। जन्मदिन के लिए जन्मदिन चुनकर तारीख सेट करें; tickle हर साल दोहराया जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki a gyakoriságot és a kezdődátumot. Születésnaphoz válaszd a Születésnap lehetőséget és állítsd be a dátumot; a tickle évente ismétlődik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli frequenza e data di inizio. Per un compleanno, scegli Compleanno e imposta la data; il tickle si ripete ogni anno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度と開始日を選びます。誕生日の場合は「誕生日」を選んで日付を設定すると、tickleが毎年繰り返されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복 주기와 시작 날짜를 선택하세요. 생일은 생일을 선택하고 날짜를 설정하면 tickle이 매년 반복됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een frequentie en begindatum. Kies voor een verjaardag Verjaardag en stel de datum in; de tickle herhaalt zich jaarlijks."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz częstotliwość i datę rozpoczęcia. W przypadku urodzin wybierz Urodziny i ustaw datę; tickle będzie powtarzać się co roku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe a frequência e a data de início. Para um aniversário, escolhe Aniversário e define a data; o tickle repete-se anualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege frecvența și data de început. Pentru o zi de naștere, alege Zi de naștere și setează data; tickle-ul se repetă anual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери частоту и дату начала. Для дня рождения выбери День рождения и укажи дату; tickle будет повторяться ежегодно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj frekvens och startdatum. För en födelsedag väljer du Födelsedag och anger datumet; tickeln upprepas årligen."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تکرار اور آغاز کی تاریخ منتخب کریں۔ سالگرہ کے لیے سالگرہ منتخب کر کے تاریخ مقرر کریں؛ tickle ہر سال دہرایا جاتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择频率和开始日期。设置生日提醒时，选择“生日”并设置日期；tickle 会每年重复。"
          }
        }
      }
    },
    "tutorial.tickle.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {

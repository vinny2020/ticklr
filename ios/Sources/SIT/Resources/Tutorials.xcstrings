    "tutorial.phone.3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your imported people in Network. Open a profile to create a tickle or add someone to a group."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على جهات الاتصال المستوردة في الشبكة. افتح ملفًا شخصيًا لإنشاء tickle أو إضافة شخص إلى مجموعة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importované kontakty najdeš v Síti. Otevři profil a vytvoř tickle nebo někoho přidej do skupiny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde deine importierten Kontakte unter Netzwerk. Öffne ein Profil, um einen Tickle zu erstellen oder jemanden einer Gruppe hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρες τις εισηγμένες επαφές στο Δίκτυο. Άνοιξε ένα προφίλ για να δημιουργήσεις ένα tickle ή να προσθέσεις κάποιον σε ομάδα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tus contactos importados en Red. Abre un perfil para crear un tickle o añadir a alguien a un grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouve tes contacts importés dans Réseau. Ouvre un profil pour créer un tickle ou ajouter une personne à un groupe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנשי הקשר המיובאים מופיעים ברשת. אפשר לפתוח פרופיל כדי ליצור tickle או להוסיף אדם לקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयात किए गए संपर्क नेटवर्क में देखें। tickle बनाने या किसी को समूह में जोड़ने के लिए प्रोफ़ाइल खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az importált névjegyeket a Hálózatban találod. Nyiss meg egy profilt tickle létrehozásához vagy valakinek a csoportba helyezéséhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova i contatti importati in Rete. Apri un profilo per creare un tickle o aggiungere qualcuno a un gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだ連絡先は「ネットワーク」に表示されます。プロフィールを開いてtickleを作成したり、グループに追加したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 연락처를 네트워크에서 찾아보세요. 프로필을 열어 tickle을 만들거나 그룹에 추가할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind je geïmporteerde contacten in Netwerk. Open een profiel om een tickle te maken of iemand aan een groep toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź zaimportowane kontakty w Sieci. Otwórz profil, aby utworzyć tickle lub dodać kogoś do grupy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra os contactos importados em Rede. Abre um perfil para criar um tickle ou adicionar alguém a um grupo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsește contactele importate în Rețea. Deschide un profil pentru a crea un tickle sau a adăuga pe cineva într-un grup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найди импортированные контакты в разделе Сеть. Открой профиль, чтобы создать tickle или добавить человека в группу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta importerade kontakter i Nätverk. Öppna en profil för att skapa en tickle eller lägga till någon i en grupp."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درآمد شدہ رابطے نیٹ ورک میں دیکھیں۔ tickle بنانے یا کسی شخص کو گروپ میں شامل کرنے کے لیے پروفائل کھولیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“人脉”中找到已导入的联系人。打开个人资料，创建 tickle 或将联系人加入群组。"
          }
        }
      }
    },
    "tutorial.linkedin.1.title": {

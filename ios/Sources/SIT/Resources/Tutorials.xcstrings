    "tutorial.phone.1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with the contacts on your phone. Your Ticklr network stays on this device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بجهات اتصال هاتفك. تبقى شبكة Ticklr على هذا الجهاز."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začni kontakty v telefonu. Tvoje síť Ticklr zůstává na tomto zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit den Kontakten auf deinem Telefon. Dein Ticklr-Netzwerk bleibt auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκίνα με τις επαφές του τηλεφώνου σου. Το δίκτυό σου στο Ticklr παραμένει σε αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con los contactos de tu teléfono. Tu red de Ticklr permanece en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence avec les contacts de ton téléphone. Ton réseau Ticklr reste sur cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להתחיל עם אנשי הקשר בטלפון. רשת ה־Ticklr שלך נשארת במכשיר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फ़ोन के संपर्कों से शुरू करें। आपका Ticklr नेटवर्क इसी डिवाइस पर रहता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdd a telefonod névjegyeivel. A Ticklr-hálózatod ezen az eszközön marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia dai contatti del telefono. La tua rete Ticklr rimane su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話の連絡先から始めましょう。Ticklrのネットワークはこの端末内に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화 연락처로 시작하세요. Ticklr 인맥은 이 기기에 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met de contacten op je telefoon. Je Ticklr-netwerk blijft op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od kontaktów w telefonie. Twoja sieć Ticklr pozostaje na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa pelos contactos do teu telefone. A tua rede Ticklr fica neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începe cu contactele din telefon. Rețeaua ta Ticklr rămâne pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начни с контактов в телефоне. Твоя сеть Ticklr остаётся на этом устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja med kontakterna på din telefon. Ditt Ticklr-nätverk stannar på den här enheten."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے فون کے رابطوں سے شروع کریں۔ آپ کا Ticklr نیٹ ورک اسی آلے پر رہتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从手机联系人开始。你的 Ticklr 人脉网络保存在此设备上。"
          }
        }
      }
    },
